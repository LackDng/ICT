# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRY=8h
ENCRYPTION_KEY=change_this_to_32_byte_hex_key_for_aes256

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/mikrotik.db

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
APPLY_RATE_LIMIT_MS=5000

# ─── WebSocket ────────────────────────────────────────────────────────────────
WS_PORT=3002

# ─── HTTPS (production) ───────────────────────────────────────────────────────
# SSL_CERT_PATH=./certs/cert.pem
# SSL_KEY_PATH=./certs/key.pem
